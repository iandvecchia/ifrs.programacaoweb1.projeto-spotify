<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             version="3.1">

    <persistence-unit name="musica-pu">

        <class>br.edu.ifrs.dominio.Banda</class>
        <class>br.edu.ifrs.dominio.Album</class>
        <class>br.edu.ifrs.dominio.Musica</class>
        <class>br.edu.ifrs.dominio.Integrante</class>

        <properties>

            <property name="jakarta.persistence.jdbc.driver"
                      value="com.mysql.cj.jdbc.Driver"/>

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3307/musica_db?createDatabaseIfNotExist=true"/>

            <property name="jakarta.persistence.jdbc.user"
                      value="root"/>

            <property name="jakarta.persistence.jdbc.password"
                      value=""/>

            <property name="hibernate.hbm2ddl.auto"
                      value="update"/>

            <property name="hibernate.show_sql"
                      value="true"/>

        </properties>

    </persistence-unit>

</persistence>